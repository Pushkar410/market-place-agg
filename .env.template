# =============================================================================
# Copy to .env  (cp .env.template .env).  .env is git-ignored.
#
# Read by:  docker compose (variable substitution in docker-compose*.yml)
# NOT read by `./mvnw spring-boot:run` - Spring does not load .env files. For a plain local run you
# need NONE of these: application-local.yml ships working defaults. To pass one, export it in your
# shell first, e.g.  export GEMINI_API_KEY=xxxx   (PowerShell: $env:GEMINI_API_KEY="xxxx")
# =============================================================================

# --- Database (docker compose) ----------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres

# --- Spring profile for docker-compose.full.yml ------------------------------
# local = Hibernate creates the schema + demo data seeded (default, recommended for the demo)
# prod  = Flyway + schema validation; requires real secrets below (see docs/AWS_DEPLOYMENT.md)
SPRING_PROFILES_ACTIVE=local

# --- Security -----------------------------------------------------------------
# Min 32 chars. The built-in default is for local development ONLY.
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- Agentic AI (optional) ----------------------------------------------------
# Leave empty: the agent understands queries with the built-in rule-based parser (works offline).
# Set a Google Gemini key (https://aistudio.google.com/apikey): the LLM parses queries instead,
# and falls back to the rule-based parser automatically if the call fails.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash-lite

# --- Aggregator ---------------------------------------------------------------
# Insert a few demo sellers/listings into PostgreSQL on startup (idempotent). Use false in production.
AGGREGATOR_DEMO_SEED=true

# --- Optional integrations (not needed for the aggregator) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXCHANGE_API_KEY=
